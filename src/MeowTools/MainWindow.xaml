<Window x:Class="MeowTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="喵喵小工具" Width="680" Height="530" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="12">
  <Grid Margin="20,18,20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="Assets/app.png" Width="48" Height="48" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="喵喵小工具" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="收好常用工具，需要时一键打开。" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="2" x:Name="MenuButton" Style="{StaticResource IconButton}" Click="Menu_Click" ToolTip="主题与关于" AutomationProperties.Name="主题与关于"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15"/>
        <Button.ContextMenu><ContextMenu><MenuItem Header="跟随系统主题" Tag="System" IsCheckable="True" Click="Theme_Click"/><MenuItem Header="浅色" Tag="Light" IsCheckable="True" Click="Theme_Click"/><MenuItem Header="深色" Tag="Dark" IsCheckable="True" Click="Theme_Click"/><Separator/><MenuItem Header="关于与许可证" Click="Licenses_Click"/></ContextMenu></Button.ContextMenu>
      </Button>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0" MinHeight="35"><DockPanel><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,9,0"/><Grid><TextBlock x:Name="SearchPlaceholder" Text="搜索工具" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="搜索工具"/></Grid></DockPanel></Border>
      <Button Grid.Column="1" x:Name="RefreshButton" Click="Refresh_Click" Margin="8,0,0,0" ToolTip="重新扫描 tools 文件夹" Content="刷新"/>
      <Button Grid.Column="2" Click="OpenFolder_Click" Margin="8,0,0,0" Content="工具文件夹"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="CountText" Text="正在读取工具…" Style="{StaticResource Hint}" Margin="1,9,0,0"/>
    </Grid>
    <Grid Grid.Row="2">
      <ListBox x:Name="ToolsList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" KeyDown="Tools_KeyDown" MouseDoubleClick="Tools_DoubleClick" AutomationProperties.Name="可启动工具">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource InsetBrush}" Margin="0,0,13,0"><Image Source="{Binding Icon}" Width="32" Height="32"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{Binding Entry.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Name}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.FullPath}"/></StackPanel>
          <Button Grid.Column="2" Content="启动" Style="{StaticResource Primary}" MinWidth="66" VerticalAlignment="Center" Click="Launch_Click" Tag="{Binding}" AutomationProperties.Name="{Binding LaunchLabel}"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="EmptyPanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24"><StackPanel><TextBlock x:Name="EmptyTitle" Text="还没有工具" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EmptyText" Text="把 EXE 或快捷方式放进同目录的 tools 文件夹，再点击刷新。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="1,10,1,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="新增工具放入 tools，刷新即可。" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBlock Grid.Column="1" Text="1.0.0" Style="{StaticResource Hint}" Margin="12,0,0,0"/></Grid>
  </Grid>
</Window>
